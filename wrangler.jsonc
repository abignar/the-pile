{
  // Cloudflare config: serve this folder as a static website,
  // with worker.js handling /api/scores (the COOM leaderboard) and
  // redirecting http:// to https:// (run_worker_first makes it see every request).
  "name": "the-pile",
  "compatibility_date": "2026-11-01",
  "main": "worker.js",
  "assets": { "directory": "./", "binding": "ASSETS", "run_worker_first": true }
  // Worldwide COOM leaderboard (KV namespace "cockpile-scores")
  ,"kv_namespaces": [{ "binding": "SCORES", "id": "7ba46c4a66d64dc898d309df8ed5e012" }]
}
